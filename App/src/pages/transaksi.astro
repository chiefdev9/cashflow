--- 
/* 
   FILE: in.astro / transaksi.astro
   DESKRIPSI: Single Page Form Switcher (True Native App Feel)
*/

import { ClientRouter } from 'astro:transitions';
import { Image } from 'astro:assets';
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="id">
<head>
    <link rel="manifest" href="/site.webmanifest" />
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
    <title>Tambah Transaksi - Cashflow Tanaejka</title>

    <ClientRouter />

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; }
    </style>
</head>
<body class="bg-slate-100 text-slate-800 flex justify-center items-center min-h-dvh p-0 sm:p-4 overflow-hidden">

    <div class="w-full sm:max-w-md h-dvh sm:h-[844px] bg-slate-50 shadow-2xl sm:rounded-3xl flex flex-col overflow-hidden relative border border-slate-200">

        <!-- Header -->
        <header class="bg-white p-4 sm:p-5 pb-5 sm:pb-6 rounded-b-[2.5rem] shadow-sm border-b border-slate-100 relative overflow-hidden flex-shrink-0 z-10">
            <div class="absolute inset-0 opacity-30 pointer-events-none overflow-hidden flex items-center justify-center">
                <Image 
                    src="/bg.jpg" 
                    alt="Aksen Vektor Header" 
                    width={800}
                    height={600}
                    class="w-full h-full object-cover scale-125 transform"
                />
            </div>

            <div class="flex justify-between items-center mb-3 sm:mb-5 relative z-10">
                <a href="/" class="w-9 h-9 rounded-full bg-slate-50/80 backdrop-blur-sm border border-slate-200 flex items-center justify-center text-slate-600 hover:bg-slate-100 transition shadow-xs">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                    </svg>
                </a>
                <h2 class="text-sm font-bold text-slate-800">Tambah Transaksi Baru</h2>
                <div class="w-9"></div>
            </div>

            <!-- TOGGLE SWITCHER NATIVE (BUKAN LINK <a>) -->
            <div class="bg-slate-100/80 backdrop-blur-md border border-slate-200/80 p-1.5 rounded-2xl shadow-inner relative z-10 flex space-x-1">
                <button 
                    id="tabIn" 
                    type="button" 
                    class="flex-1 py-2 text-xs font-semibold rounded-xl transition-all duration-200 text-center bg-emerald-600 text-white shadow-sm cursor-pointer"
                >
                    Pemasukan (In)
                </button>
                <button 
                    id="tabOut" 
                    type="button" 
                    class="flex-1 py-2 text-xs font-semibold rounded-xl transition-all duration-200 text-center text-slate-600 hover:text-slate-900 cursor-pointer"
                >
                    Pengeluaran (Out)
                </button>
            </div>
        </header>

        <!-- Main Form Content -->
        <main class="flex-1 overflow-y-auto p-4 space-y-3 sm:space-y-4 pb-48">
            <form id="formTransaksi" class="space-y-3 sm:space-y-4">
                
                <!-- Nominal Input -->
                <div class="bg-white p-3.5 sm:p-4 rounded-2xl shadow-sm border border-slate-100 space-y-1">
                    <label id="labelNominal" class="block text-[11px] font-bold uppercase tracking-wider text-emerald-600 transition-colors">
                        Nominal Pemasukan
                    </label>
                    <div class="relative flex items-center">
                        <span class="text-lg font-bold text-slate-400 mr-2">Rp</span>
                        <input 
                            id="nominal"
                            type="text" 
                            inputmode="numeric"
                            pattern="[0-9]*"
                            placeholder="0" 
                            class="w-full text-xl font-bold text-slate-800 focus:outline-none bg-transparent placeholder-slate-300"
                        />
                    </div>
                </div>

                <!-- Sumber Input -->
                <div class="bg-white p-3.5 sm:p-4 rounded-2xl shadow-sm border border-slate-100 space-y-1">
                    <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-400">
                        Sumber
                    </label>
                    <select id="sumber" class="w-full text-sm font-semibold text-slate-700 focus:outline-none bg-transparent cursor-pointer">
                        <option value="Rutin">Rutin</option>
                        <option value="Tentatif">Tentatif</option>
                    </select>
                </div>

                <div class="grid grid-cols-2 gap-3">
                    <!-- Kategori Input -->
                    <div class="bg-white p-3.5 sm:p-4 rounded-2xl shadow-sm border border-slate-100 space-y-1">
                        <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-400">
                            Kategori
                        </label>
                        <select id="kategori" class="w-full text-xs font-semibold text-slate-700 focus:outline-none bg-transparent cursor-pointer">
                            <!-- Option diisi via JS secara dinamis -->
                        </select>
                    </div>

                    <!-- Tanggal Input -->
                    <div class="bg-white p-3.5 sm:p-4 rounded-2xl shadow-sm border border-slate-100 space-y-1">
                        <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-400">
                            Tanggal
                        </label>
                        <input 
                            id="waktu"
                            type="date" 
                            class="w-full text-xs font-semibold text-slate-700 focus:outline-none bg-transparent cursor-pointer"
                        />
                    </div>
                </div>

                <!-- Catatan Input -->
                <div class="bg-white p-3.5 sm:p-4 rounded-2xl shadow-sm border border-slate-100 space-y-1">
                    <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-400">
                        Catatan (Opsional)
                    </label>
                    <textarea 
                        id="catatan"
                        rows="2"
                        placeholder="Tambahkan detail catatan jika perlu..." 
                        class="w-full text-xs text-slate-800 focus:outline-none bg-transparent placeholder-slate-300 resize-none font-medium"
                    ></textarea>
                </div>
            </form>
        </main>

        <!-- Tombol Simpan Native -->
        <div class="absolute bottom-28 left-0 right-0 px-6 pointer-events-none z-30">
            <button id="btnSimpan" type="button" class="pointer-events-auto w-full bg-emerald-600 hover:bg-emerald-700 text-white font-medium py-3 rounded-xl shadow-lg text-sm transition-all duration-200 transform active:scale-95 flex items-center justify-center space-x-2 cursor-pointer">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span id="btnText">Simpan Pemasukan</span>
            </button>
        </div>

    </div>

    <script>
        const scriptURL = 'https://script.google.com/macros/s/AKfycbwYcQfOxkX5tILNy-VjNBx0bRVdCkpiTNvEoTtJpakX_9sU9m10NC5IiePonxTlkbk4-w/exec';

        // Pilihan Kategori Berdasarkan Mode
        const categories = {
            In: ['Usaha', 'Gaji', 'Investasi', 'Lainnya'],
            Out: ['Kebutuhan Pokok', 'Transportasi', 'Hiburan', 'Lainnya']
        };

        let currentJenis = 'In'; // Default state adalah Pemasukan

        document.addEventListener('astro:page-load', () => {
            const tabIn = document.getElementById('tabIn');
            const tabOut = document.getElementById('tabOut');
            const labelNominal = document.getElementById('labelNominal');
            const kategoriEl = document.getElementById('kategori') as HTMLSelectElement | null;
            const btnSimpan = document.getElementById('btnSimpan');
            const btnText = document.getElementById('btnText');
            const nominalEl = document.getElementById('nominal') as HTMLInputElement | null;
            const waktuEl = document.getElementById('waktu') as HTMLInputElement | null;

            // Set Tanggal Hari Ini
            if (waktuEl && !waktuEl.value) {
                const today = new Date();
                const yyyy = today.getFullYear();
                const mm = String(today.getMonth() + 1).padStart(2, '0');
                const dd = String(today.getDate()).padStart(2, '0');
                waktuEl.value = `${yyyy}-${mm}-${dd}`;
            }

            // Fungsi Mengubah Tampilan Kategori Dinamis
            function renderKategori(jenis: 'In' | 'Out') {
                if (!kategoriEl) return;
                kategoriEl.innerHTML = categories[jenis]
                    .map(item => `<option value="${item}">${item}</option>`)
                    .join('');
            }

            // Fungsi Switcher Tab Native
            function setMode(jenis: 'In' | 'Out') {
                currentJenis = jenis;
                renderKategori(jenis);

                if (jenis === 'In') {
                    // Tampilan Pemasukan (Emerald)
                    tabIn?.classList.add('bg-emerald-600', 'text-white', 'shadow-sm');
                    tabIn?.classList.remove('text-slate-600');

                    tabOut?.classList.remove('bg-rose-600', 'text-white', 'shadow-sm');
                    tabOut?.classList.add('text-slate-600');

                    if (labelNominal) {
                        labelNominal.innerText = 'Nominal Pemasukan';
                        labelNominal.className = 'block text-[11px] font-bold uppercase tracking-wider text-emerald-600 transition-colors';
                    }

                    if (btnSimpan) {
                        btnSimpan.className = 'pointer-events-auto w-full bg-emerald-600 hover:bg-emerald-700 text-white font-medium py-3 rounded-xl shadow-lg text-sm transition-all duration-200 transform active:scale-95 flex items-center justify-center space-x-2 cursor-pointer';
                    }
                    if (btnText) btnText.innerText = 'Simpan Pemasukan';

                } else {
                    // Tampilan Pengeluaran (Rose)
                    tabOut?.classList.add('bg-rose-600', 'text-white', 'shadow-sm');
                    tabOut?.classList.remove('text-slate-600');

                    tabIn?.classList.remove('bg-emerald-600', 'text-white', 'shadow-sm');
                    tabIn?.classList.add('text-slate-600');

                    if (labelNominal) {
                        labelNominal.innerText = 'Nominal Pengeluaran';
                        labelNominal.className = 'block text-[11px] font-bold uppercase tracking-wider text-rose-600 transition-colors';
                    }

                    if (btnSimpan) {
                        btnSimpan.className = 'pointer-events-auto w-full bg-rose-600 hover:bg-rose-700 text-white font-medium py-3 rounded-xl shadow-lg text-sm transition-all duration-200 transform active:scale-95 flex items-center justify-center space-x-2 cursor-pointer';
                    }
                    if (btnText) btnText.innerText = 'Simpan Pengeluaran';
                }
            }

            // Init Kategori & Event Handler Tab
            renderKategori('In');

            tabIn?.addEventListener('click', () => setMode('In'));
            tabOut?.addEventListener('click', () => setMode('Out'));

            // Formatting Input Nominal
            if (nominalEl && !(nominalEl as any)._hasInputListener) {
                (nominalEl as any)._hasInputListener = true;
                nominalEl.addEventListener('input', (e) => {
                    const input = e.target as HTMLInputElement;
                    let value = input.value.replace(/\D/g, '');
                    if (value) {
                        value = Number(value).toLocaleString('en-US');
                    }
                    input.value = value;
                });
            }

            // Handling Simpan Data (Akurat Sesuai Mode Aktif)
            if (btnSimpan && !(btnSimpan as any)._hasClickListener) {
                (btnSimpan as any)._hasClickListener = true;

                btnSimpan.addEventListener('click', async () => {
                    const btn = btnSimpan as HTMLButtonElement;
                    if (btn.disabled) return;
                    btn.disabled = true;

                    if (btnText) btnText.innerText = 'Menyimpan...';

                    const sumberEl = document.getElementById('sumber') as HTMLSelectElement | null;
                    const catatanEl = document.getElementById('catatan') as HTMLTextAreaElement | null;

                    const rawNominal = nominalEl ? nominalEl.value.replace(/,/g, '') : '';

                    let formattedDate = '';
                    if (waktuEl && waktuEl.value) {
                        const [y, m, d] = waktuEl.value.split('-');
                        formattedDate = `${parseInt(m)}/${parseInt(d)}/${y}`;
                    }

                    // Data jenis mengambil state 'currentJenis' aktif (In / Out)
                    const formBody = new URLSearchParams({
                        jenis: currentJenis, 
                        angka: rawNominal,
                        sumber: sumberEl ? sumberEl.value : '',
                        kategori: kategoriEl ? kategoriEl.value : '',
                        waktu: formattedDate,
                        catatan: catatanEl ? catatanEl.value : ''
                    });

                    try {
                        await fetch(scriptURL, {
                            method: 'POST',
                            mode: 'no-cors',
                            headers: {
                                'Content-Type': 'application/x-www-form-urlencoded',
                            },
                            body: formBody.toString()
                        });

                        alert(`${currentJenis === 'In' ? 'Pemasukan' : 'Pengeluaran'} berhasil disimpan!`);
                        window.location.href = '/'; // Kembali ke Halaman Utama

                    } catch (error) {
                        alert('Terjadi kesalahan koneksi.');
                        console.error('Error!', error);
                        btn.disabled = false;
                        if (btnText) btnText.innerText = `Simpan ${currentJenis === 'In' ? 'Pemasukan' : 'Pengeluaran'}`;
                    }
                });
            }
        });
    </script>
</body>
</html>