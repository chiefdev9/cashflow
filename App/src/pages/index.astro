--- 
/* 
   FILE: index.astro
   DESKRIPSI: Dashboard Cashflow Tanaejka dengan Header Tegas, 4 Transaksi Terbaru & FAB Minimalis.
*/

import { ClientRouter } from 'astro:transitions';
import { Image } from 'astro:assets';
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="id">
<head>
    <link rel="manifest" href="/site.webmanifest" />

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
    <title>Cashflow Tanaejka</title>
    
    <!-- Client Router untuk Navigasi Instan (SPA feel) -->
    <ClientRouter />

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; }
    </style>
</head>
<body class="bg-slate-100 text-slate-800 flex justify-center items-center min-h-dvh p-0 sm:p-4 overflow-hidden">

    <!-- Frame Mobile / App Container -->
    <div class="w-full sm:max-w-md h-dvh sm:h-[844px] bg-slate-50 shadow-2xl sm:rounded-3xl flex flex-col overflow-hidden relative border border-slate-200">
        
        <!-- HEADER & CARD RINGKASAN (Desain Tegas & Jelas) -->
        <header class="bg-white p-4 pb-5 rounded-b-[2.5rem] shadow-sm border-b border-slate-100 relative overflow-hidden flex-shrink-0 z-10">
            
            <!-- Background Image Accent -->
            <div class="absolute inset-0 opacity-25 pointer-events-none overflow-hidden flex items-center justify-center">
                <Image 
                    src="/bg.jpg" 
                    alt="Aksen Vektor Header" 
                    width={800}
                    height={600}
                    class="w-full h-full object-cover scale-125 transform"
                />
            </div>

            <!-- Profile Info & Bell -->
            <div class="flex justify-between items-center mb-4 relative z-10">
                <div class="flex items-center space-x-3">
                    <div class="w-10 h-10 rounded-full bg-slate-100 border border-slate-200/80 flex items-center justify-center font-bold text-xs text-slate-700 shadow-xs">
                        ST
                    </div>
                    <div>
                        <p class="text-[9px] uppercase tracking-wider text-slate-400 font-bold leading-none">CASHFLOW TANAEJKA</p>
                        <h2 class="text-sm font-extrabold text-slate-900 mt-1">Agustus 2026</h2>
                    </div>
                </div>
                <button class="w-9 h-9 rounded-full bg-slate-50 border border-slate-200/80 flex items-center justify-center text-slate-500 shadow-xs cursor-pointer hover:bg-slate-100 transition">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
                    </svg>
                </button>
            </div>

            <!-- Card Utama Ringkasan Data -->
            <div class="bg-white/95 backdrop-blur-md border border-slate-200/90 p-4 rounded-2xl shadow-sm relative z-10 space-y-3">
                
                <!-- Row Top Metrics -->
                <div class="grid grid-cols-3 gap-1 items-center">
                    <div>
                        <span class="text-[9px] text-slate-400 uppercase tracking-wider font-bold block truncate">PERPUTARAN</span>
                        <h2 id="txtPerputaran" class="text-sm font-extrabold text-slate-800 mt-1 tracking-tight">Memuat...</h2>
                    </div>
                    <div class="text-center px-1 border-x border-slate-200/60">
                        <span class="text-[9px] text-slate-400 uppercase tracking-wider font-bold block truncate">SISA BULANAN</span>
                        <h2 id="txtSisaBulanan" class="text-sm font-extrabold text-indigo-600 mt-1 tracking-tight">Memuat...</h2>
                    </div>
                    <div class="text-right pl-1">
                        <span class="text-[9px] text-slate-400 uppercase tracking-wider font-bold block truncate">SALDO AKHIR</span>
                        <h2 id="txtSaldoAkhir" class="text-sm font-extrabold text-emerald-600 mt-1 tracking-tight">Memuat...</h2>
                    </div>
                </div>

                <div class="border-t border-slate-100"></div>

                <!-- Row In / Out Metrics -->
                <div class="grid grid-cols-2 gap-2.5">
                    <div class="bg-slate-50/90 p-2.5 rounded-xl border border-slate-200/60">
                        <p class="text-[10px] text-slate-400 font-semibold leading-none">Pemasukan (In)</p>
                        <p id="txtPemasukan" class="text-sm font-extrabold text-emerald-600 mt-1">Memuat...</p>
                    </div>
                    <div class="bg-slate-50/90 p-2.5 rounded-xl border border-slate-200/60">
                        <p class="text-[10px] text-slate-400 font-semibold leading-none">Pengeluaran (Out)</p>
                        <p id="txtPengeluaran" class="text-sm font-extrabold text-rose-600 mt-1">Memuat...</p>
                    </div>
                </div>

            </div>
        </header>

        <!-- MAIN CONTENT: DUA TAB (RIWAYAT & STATISTIK) -->
        <main class="flex-1 overflow-y-auto p-4 pb-32">
            <!-- Pilihan Tab Navigation -->
            <div class="flex justify-between items-center border-b border-slate-200 mb-4 pb-2">
                <div class="flex space-x-6 text-xs font-bold">
                    <button id="tabRiwayat" class="pb-2 border-b-2 border-slate-800 text-slate-800 transition">Riwayat Transaksi</button>
                    <button id="tabStatistik" class="pb-2 border-b-2 border-transparent text-slate-400 hover:text-slate-600 transition">Statistik</button>
                </div>
                <a href="/transaksi" class="text-[11px] text-indigo-600 font-semibold hover:underline pb-2">Lihat Semua</a>
            </div>

            <!-- Konten Tab 1: Riwayat Transaksi (Max 4 Items) -->
            <section id="contentRiwayat" class="space-y-2">
                <div id="loadingState" class="text-center py-6 text-xs text-slate-400">
                    Memuat 4 transaksi terbaru...
                </div>
                <div id="listTransaksi" class="space-y-2"></div>
            </section>

            <!-- Konten Tab 2: Grafik/Statistik -->
            <section id="contentStatistik" class="hidden">
                <div class="bg-white p-4 rounded-2xl border border-slate-100 shadow-sm text-center">
                    <p class="text-xs font-semibold text-slate-500">Statistik Bulan Agustus 2026</p>
                    <div class="h-40 flex items-center justify-center text-slate-300 text-xs">
                        [Grafik Statistik Supabase]
                    </div>
                </div>
            </section>
        </main>

        <!-- FAB (Floating Action Button) Tambah Transaksi -->
        <div class="absolute bottom-6 left-0 right-0 px-6 flex justify-center z-30 pointer-events-none">
            <a href="/out" class="pointer-events-auto bg-slate-900 hover:bg-slate-800 text-white font-medium py-3 px-6 rounded-full shadow-xl text-xs sm:text-sm transition transform active:scale-95 flex items-center space-x-2 border border-slate-700 no-underline">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                </svg>
                <span>Tambah Transaksi</span>
            </a>
        </div>

    </div>

    <!-- SCRIPT REALTIME SUPABASE INTEGRATION -->
    <script>
        import { createClient } from '@supabase/supabase-js';

        const supabaseUrl = 'https://qcmfltewnmtvpswthbcj.supabase.co';
        const supabaseKey = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InFjbWZsdGV3bm10dnBzd3RoYmNqIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODY5MzEyMjEsImV4cCI6MjEwMjUwNzIyMX0.gj5rUMELfGeyIOtmWepN-rekU1-lubX1ll-zyGHzVCU';
        
        const supabase = createClient(supabaseUrl, supabaseKey);
        const TARGET_BULAN = 'Agust';

        // Helper Format Rupiah
        function formatRupiah(val: number | null | undefined): string {
            if (val === null || val === undefined) return 'Rp 0';
            const isNegative = val < 0;
            const formatted = Math.abs(val).toLocaleString('id-ID');
            return isNegative ? `-Rp ${formatted}` : `Rp ${formatted}`;
        }

        // 1. FUNGSI FETCH SUMMARY DARI TABEL 'summary'
        async function fetchSummary() {
            const { data, error } = await supabase
                .from('summary')
                .select('*')
                .eq('Bulan', TARGET_BULAN)
                .single();

            if (error) {
                console.error('Gagal mengambil data summary:', error);
                return;
            }

            if (data) {
                const elPerputaran = document.getElementById('txtPerputaran');
                const elSisaBulanan = document.getElementById('txtSisaBulanan');
                const elSaldoAkhir = document.getElementById('txtSaldoAkhir');
                const elPemasukan = document.getElementById('txtPemasukan');
                const elPengeluaran = document.getElementById('txtPengeluaran');

                if (elPerputaran) elPerputaran.innerText = formatRupiah(data.Perputaran);
                
                if (elSisaBulanan) {
                    let sisaVal = Number(data.Sisa_Bulanan) || 0;
                    elSisaBulanan.innerText = formatRupiah(sisaVal);
                    elSisaBulanan.className = 'text-sm font-extrabold mt-1 tracking-tight ' + (sisaVal < 0 ? 'text-rose-600' : 'text-emerald-600');
                }

                if (elSaldoAkhir) {
                    let saldoVal = Number(data.Sisa_Akhir) || 0;
                    elSaldoAkhir.innerText = formatRupiah(saldoVal);
                    elSaldoAkhir.className = 'text-sm font-extrabold mt-1 tracking-tight ' + (saldoVal < 0 ? 'text-rose-600' : 'text-emerald-600');
                }

                if (elPemasukan) elPemasukan.innerText = formatRupiah(data.Pemasukan);
                if (elPengeluaran) elPengeluaran.innerText = formatRupiah(data.Pengeluaran);
            }
        }

        // 2. FUNGSI FETCH RIWAYAT TRANSAKSI DARI TABEL 'transaksi' (LIMIT 4 ITEM)
        async function fetchTransaksi() {
            const listEl = document.getElementById('listTransaksi');
            const loadingEl = document.getElementById('loadingState');

            const { data, error } = await supabase
                .from('transaksi')
                .select('*')
                .order('created_at', { ascending: false })
                .limit(4); // Dibatasi maksimal 4 transaksi terbaru

            if (loadingEl) loadingEl.style.display = 'none';

            if (error) {
                console.error('Gagal mengambil riwayat transaksi:', error);
                if (listEl) listEl.innerHTML = `<p class="text-xs text-center text-rose-500 py-4">Gagal memuat riwayat.</p>`;
                return;
            }

            if (listEl && data) {
                if (data.length === 0) {
                    listEl.innerHTML = `<p class="text-xs text-center text-slate-400 py-4">Belum ada transaksi.</p>`;
                    return;
                }

                listEl.innerHTML = data.map((t: any) => {
                    const isIn = t.jenis === 'In';
                    const amountFormatted = (isIn ? '+ ' : '- ') + formatRupiah(t.angka);
                    const textColor = isIn ? 'text-emerald-600' : 'text-rose-600';
                    const badgeBg = isIn ? 'bg-emerald-50 text-emerald-600' : 'bg-rose-50 text-rose-600';

                    return `
                        <div class="bg-white p-3 rounded-2xl border border-slate-100 shadow-xs flex justify-between items-center">
                            <div class="flex items-center space-x-3">
                                <div class="w-8 h-8 rounded-xl ${badgeBg} flex items-center justify-center font-bold text-xs">
                                    ${isIn ? 'IN' : 'OUT'}
                                </div>
                                <div>
                                    <h3 class="text-xs font-bold text-slate-800">${t.kategori || 'Transaksi'}</h3>
                                    <p class="text-[10px] font-medium text-slate-400">${t.sumber || ''} ${t.catatan ? '• ' + t.catatan : ''}</p>
                                </div>
                            </div>
                            <div class="text-right">
                                <span class="block text-xs font-bold ${textColor}">${amountFormatted}</span>
                                <span class="text-[9px] text-slate-400">${t.waktu ? t.waktu.split('T')[0] : ''}</span>
                            </div>
                        </div>
                    `;
                }).join('');
            }
        }

        function initDashboard() {
            fetchSummary();
            fetchTransaksi();

            // 3. LISTEN TO SUPABASE REALTIME
            supabase
                .channel('db-changes')
                .on('postgres_changes', { event: '*', schema: 'public', table: 'summary' }, () => fetchSummary())
                .on('postgres_changes', { event: '*', schema: 'public', table: 'transaksi' }, () => fetchTransaksi())
                .subscribe();

            // 4. TAB SWITCHING LOGIC
            const tabRiwayat = document.getElementById('tabRiwayat');
            const tabStatistik = document.getElementById('tabStatistik');
            const contentRiwayat = document.getElementById('contentRiwayat');
            const contentStatistik = document.getElementById('contentStatistik');

            tabRiwayat?.addEventListener('click', () => {
                contentRiwayat?.classList.remove('hidden');
                contentStatistik?.classList.add('hidden');
                tabRiwayat.className = 'pb-2 border-b-2 border-slate-800 text-slate-800 transition';
                if (tabStatistik) tabStatistik.className = 'pb-2 border-b-2 border-transparent text-slate-400 hover:text-slate-600 transition';
            });

            tabStatistik?.addEventListener('click', () => {
                contentStatistik?.classList.remove('hidden');
                contentRiwayat?.classList.add('hidden');
                tabStatistik.className = 'pb-2 border-b-2 border-slate-800 text-slate-800 transition';
                if (tabRiwayat) tabRiwayat.className = 'pb-2 border-b-2 border-transparent text-slate-400 hover:text-slate-600 transition';
            });
        }

        document.addEventListener('astro:page-load', () => {
            initDashboard();
        });
    </script>
</body>
</html>