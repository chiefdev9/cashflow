---
/* 
    FILE: src/pages/index.astro
    DESKRIPSI: Dashboard Utama Cashflow Tanaejka (Statistik & Tombol Navigasi)
*/

import { Image } from 'astro:assets';
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="id">
<head>
    <link rel="manifest" href="/site.webmanifest" />
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
    <title>Dashboard - Cashflow Tanaejka</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; }
    </style>
</head>
<body class="bg-slate-100 text-slate-800 flex justify-center items-center min-h-dvh p-0 sm:p-4 overflow-hidden">

    <!-- Container Utama: Frame HP -->
    <div class="w-full sm:max-w-md h-dvh sm:h-[844px] bg-slate-50 shadow-2xl sm:rounded-3xl flex flex-col overflow-hidden relative border border-slate-200">

        <!-- Header Dashboard -->
        <header class="bg-white p-4 sm:p-5 pb-5 sm:pb-6 rounded-b-[2.5rem] shadow-sm border-b border-slate-100 relative overflow-hidden flex-shrink-0 z-10">
            <div class="absolute inset-0 opacity-30 pointer-events-none overflow-hidden flex items-center justify-center">
                <Image 
                    src="/bg.jpg" 
                    alt="Aksen Vektor Header" 
                    width={800}
                    height={600}
                    class="w-full h-full object-cover scale-125 transform"
                />
            </div>

            <div class="flex justify-between items-center mb-4 relative z-10">
                <div>
                    <h1 class="text-base font-bold text-slate-800">Cashflow Tanaejka</h1>
                    <p class="text-[11px] text-slate-500 font-medium">Ringkasan Keuangan Ringkas</p>
                </div>
                <!-- Indikator Sync Status -->
                <div id="syncIndicator" class="flex items-center space-x-1.5 bg-slate-100 px-2.5 py-1 rounded-full border border-slate-200">
                    <span id="syncDot" class="w-2 h-2 rounded-full bg-emerald-500"></span>
                    <span id="syncText" class="text-[10px] font-semibold text-slate-600">Synced</span>
                </div>
            </div>

            <!-- Card Total Saldo -->
            <div class="bg-slate-900 text-white p-4 sm:p-5 rounded-2xl shadow-md relative z-10 space-y-1">
                <p class="text-[11px] font-semibold uppercase tracking-wider text-slate-400">Total Saldo Bersih</p>
                <h3 id="txtTotalSaldo" class="text-2xl font-bold tracking-tight">Rp 0</h3>
            </div>
        </header>

        <!-- Main Content (Ringkasan In / Out & Navigasi) -->
        <main class="flex-1 overflow-y-auto p-4 space-y-3 sm:space-y-4 pb-32">
            
            <!-- Ringkasan In vs Out -->
            <div class="grid grid-cols-2 gap-3">
                <div class="bg-white p-3.5 sm:p-4 rounded-2xl shadow-sm border border-slate-100 space-y-1">
                    <p class="text-[10px] font-bold uppercase tracking-wider text-emerald-600">Total Pemasukan</p>
                    <p id="txtTotalIn" class="text-base font-bold text-slate-800">Rp 0</p>
                </div>
                <div class="bg-white p-3.5 sm:p-4 rounded-2xl shadow-sm border border-slate-100 space-y-1">
                    <p class="text-[10px] font-bold uppercase tracking-wider text-rose-600">Total Pengeluaran</p>
                    <p id="txtTotalOut" class="text-base font-bold text-slate-800">Rp 0</p>
                </div>
            </div>

            <!-- Akses Cepat / Menu Navigasi Form -->
            <div class="bg-white p-4 rounded-2xl shadow-sm border border-slate-100 space-y-3">
                <h2 class="text-xs font-bold text-slate-400 uppercase tracking-wider">Tambah Transaksi Baru</h2>
                <div class="grid grid-cols-2 gap-3">
                    <button id="btnGoToIn" type="button" class="w-full bg-emerald-50 hover:bg-emerald-100 border border-emerald-200 text-emerald-700 font-semibold py-3 px-4 rounded-xl text-xs transition flex items-center justify-center space-x-2 cursor-pointer active:scale-95">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                        </svg>
                        <span>Pemasukan (In)</span>
                    </button>

                    <button id="btnGoToOut" type="button" class="w-full bg-rose-50 hover:bg-rose-100 border border-rose-200 text-rose-700 font-semibold py-3 px-4 rounded-xl text-xs transition flex items-center justify-center space-x-2 cursor-pointer active:scale-95">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 12H4" />
                        </svg>
                        <span>Pengeluaran (Out)</span>
                    </button>
                </div>
            </div>

        </main>

    </div>

    <script>
        import { createClient } from '@supabase/supabase-js';

        const supabaseUrl = 'https://qcmfltewnmtvpswthbcj.supabase.co';
        const supabaseKey = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InFjbWZsdGV3bm10dnBzd3RoYmNqIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODY5MzEyMjEsImV4cCI6MjEwMjUwNzIyMX0.gj5rUMELfGeyIOtmWepN-rekU1-lubX1ll-zyGHzVCU';
        
        const supabase = createClient(supabaseUrl, supabaseKey);

        // 1. FUNGSI NAVIGASI BERSIH TANPA MENUMPUK HISTORY (Melindungi dari tombol Back)
        function navigateCleanly(targetUrl: string) {
            history.replaceState(null, '', targetUrl);
            window.location.replace(targetUrl);
        }

        // Event Listener untuk Tombol Tambah Transaksi
        const btnGoToIn = document.getElementById('btnGoToIn');
        if (btnGoToIn) {
            btnGoToIn.addEventListener('click', () => navigateCleanly('/in'));
        }

        const btnGoToOut = document.getElementById('btnGoToOut');
        if (btnGoToOut) {
            btnGoToOut.addEventListener('click', () => navigateCleanly('/out'));
        }

        // 2. LOGIKA KELUAR PWA PADA TOMBOL BACK ANDROID
        // Memastikan jika tombol back fisik/segitiga Android ditekan dari Dashboard, PWA langsung keluar ke Home Screen
        window.addEventListener('load', () => {
            // Bersihkan riwayat tumpukan dan atur titik awal
            history.replaceState({ page: 'home' }, '', location.href);

            window.addEventListener('popstate', () => {
                // Ketika back ditekan dari titik home ini, tutup aplikasi/kembali ke home screen HP
                window.close();
            });
        });

        // 3. LOGIKA MEMUAT DATA SUMMARY DARI SUPABASE
        async function fetchSummary() {
            const syncDot = document.getElementById('syncDot');
            const syncText = document.getElementById('syncText');

            // Cek jika ada data baru dari form
            const syncState = localStorage.getItem('cashflow_sync_state');
            if (syncState === 'unsynced' && syncDot && syncText) {
                syncDot.className = 'w-2 h-2 rounded-full bg-amber-500 animate-ping';
                syncText.innerText = 'Syncing...';
            }

            try {
                const { data, error } = await supabase
                    .from('summary')
                    .select('*')
                    .single();

                if (error) throw error;

                if (data) {
                    const txtTotalSaldo = document.getElementById('txtTotalSaldo');
                    const txtTotalIn = document.getElementById('txtTotalIn');
                    const txtTotalOut = document.getElementById('txtTotalOut');

                    if (txtTotalSaldo) txtTotalSaldo.innerText = `Rp ${(data.total_saldo || 0).toLocaleString('id-ID')}`;
                    if (txtTotalIn) txtTotalIn.innerText = `Rp ${(data.total_in || 0).toLocaleString('id-ID')}`;
                    if (txtTotalOut) txtTotalOut.innerText = `Rp ${(data.total_out || 0).toLocaleString('id-ID')}`;
                }

                // Update Indikator Sync ke Selesai
                localStorage.removeItem('cashflow_sync_state');
                if (syncDot && syncText) {
                    syncDot.className = 'w-2 h-2 rounded-full bg-emerald-500';
                    syncText.innerText = 'Synced';
                }

            } catch (err) {
                console.error('Gagal mengambil data summary:', err);
                if (syncDot && syncText) {
                    syncDot.className = 'w-2 h-2 rounded-full bg-rose-500';
                    syncText.innerText = 'Offline';
                }
            }
        }

        fetchSummary();
    </script>
</body>
</html>