---
/* 
   FILE: index.astro
   DESKRIPSI: Dashboard Utama dengan aksi tombol melayang (floating).
*/

import { Image } from 'astro:assets';
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="id">
<head>
    <link rel="manifest" href="/site.webmanifest" />
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
    <title>Dashboard - Cashflow Tanaejka</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; }
    </style>
</head>
<body class="bg-slate-100 text-slate-800 flex justify-center items-center min-h-dvh p-0 sm:p-4 overflow-hidden">

    <!-- Container Utama: Frame HP -->
    <div class="w-full sm:max-w-md h-dvh sm:h-[844px] bg-slate-50 shadow-2xl sm:rounded-3xl flex flex-col overflow-hidden relative border border-slate-200">

        <!-- Header -->
        <header class="bg-white p-4 sm:p-5 pb-5 sm:pb-6 rounded-b-[2.5rem] shadow-sm border-b border-slate-100 relative overflow-hidden flex-shrink-0 z-10">
            <div class="absolute inset-0 opacity-30 pointer-events-none overflow-hidden flex items-center justify-center">
                <Image 
                    src="/bg.jpg" 
                    alt="Aksen Vektor Header" 
                    width={800}
                    height={600}
                    class="w-full h-full object-cover scale-125 transform"
                />
            </div>

            <div class="flex justify-between items-center mb-3 sm:mb-5 relative z-10">
                <h2 class="text-sm font-bold text-slate-800">Cashflow Tanaejka</h2>
            </div>
        </header>

        <!-- Main Content (Diberi pb-48 agar konten terbawah tidak tertutup tombol absolut) -->
        <main class="flex-1 overflow-y-auto p-4 space-y-3 sm:space-y-4 pb-48">
            <!-- Konten Dashboard Anda di sini -->
            <div class="bg-white p-4 rounded-2xl shadow-sm border border-slate-100">
                <p class="text-xs text-slate-500 font-medium">Ringkasan Transaksi</p>
                <!-- Detail ringkasan/transaksi -->
            </div>
        </main>

        <!-- TOMBOL AKSI MELAYANG (MENYESUAIKAN DENGAN IN & OUT) -->
        <div class="absolute bottom-28 left-0 right-0 px-6 pointer-events-none z-30">
            <div class="flex space-x-3 pointer-events-auto">
                <a href="/in" class="flex-1 bg-emerald-600 hover:bg-emerald-700 text-white font-medium py-3 rounded-xl shadow-lg text-sm transition transform active:scale-95 flex items-center justify-center space-x-2 cursor-pointer">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                    </svg>
                    <span>Masuk (In)</span>
                </a>
                <a href="/out" class="flex-1 bg-rose-600 hover:bg-rose-700 text-white font-medium py-3 rounded-xl shadow-lg text-sm transition transform active:scale-95 flex items-center justify-center space-x-2 cursor-pointer">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 12H4" />
                    </svg>
                    <span>Keluar (Out)</span>
                </a>
            </div>
        </div>

    </div>

</body>
</html>