---
/* 
   FILE: out.astro
   DESKRIPSI: Form Input Transaksi Out (Layout Presisi 1 Layar HP).
*/

import { Image } from 'astro:assets';
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Tambah Pengeluaran - Cashflow</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; }
    </style>
</head>
<body class="bg-slate-100 text-slate-800 flex justify-center items-center min-h-dvh p-0 sm:p-4 overflow-hidden">

    <!-- Container Utama: Menyesuaikan Tinggi Viewport HP (h-dvh) -->
    <div class="w-full sm:max-w-md h-dvh sm:h-[844px] bg-slate-50 shadow-2xl sm:rounded-3xl flex flex-col overflow-hidden relative border border-slate-200">

        <!-- HEADER FORM -->
        <header class="bg-white p-4 pb-4 rounded-b-[2rem] shadow-sm border-b border-slate-100 relative overflow-hidden flex-shrink-0">
            <!-- Background Vektor Header -->
            <div class="absolute inset-0 opacity-20 pointer-events-none overflow-hidden flex items-center justify-center">
                <Image
                    src="/bg.jpg"
                    alt="Aksen Vektor Header"
                    width={800}
                    height={600}
                    class="w-full h-full object-cover scale-125 transform"
                />
            </div>

            <!-- Top Bar Navigasi Kembali -->
            <div class="flex justify-between items-center relative z-10">
                <a href="/" class="w-8 h-8 rounded-full bg-slate-100/80 backdrop-blur-sm border border-slate-200 flex items-center justify-center text-slate-600 shadow-sm active:scale-95 transition">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                    </svg>
                </a>
                <h1 class="text-sm font-bold text-slate-800">Tambah Pengeluaran</h1>
                <div class="w-8 h-8 opacity-0"></div> <!-- Spacer penyeimbang layout -->
            </div>
        </header>

        <!-- KONTEN FORM (FIT LAYAR) -->
        <main class="flex-1 overflow-y-auto p-4 pb-24 flex flex-col justify-between">
            <form id="form-out" class="space-y-4">
                <!-- Nominal / Jumlah -->
                <div>
                    <label class="block text-[10px] font-bold uppercase tracking-wider text-slate-400 mb-1">Nominal (Rp)</label>
                    <div class="relative flex items-center">
                        <span class="absolute left-3 text-sm font-bold text-rose-500">Rp</span>
                        <input 
                            type="number" 
                            id="input-jumlah"
                            required
                            placeholder="0"
                            class="w-full pl-10 pr-4 py-2.5 bg-white border border-slate-200 rounded-xl font-bold text-slate-800 placeholder-slate-300 focus:outline-none focus:ring-2 focus:ring-rose-500/20 focus:border-rose-500 text-sm"
                        />
                    </div>
                </div>

                <!-- Kategori -->
                <div>
                    <label class="block text-[10px] font-bold uppercase tracking-wider text-slate-400 mb-1">Kategori</label>
                    <select id="input-kategori" class="w-full px-3 py-2.5 bg-white border border-slate-200 rounded-xl font-medium text-xs text-slate-700 focus:outline-none focus:ring-2 focus:ring-rose-500/20 focus:border-rose-500">
                        <option value="Rutin">Rutin</option>
                        <option value="Prediksi">Prediksi</option>
                        <option value="Usaha">Usaha</option>
                        <option value="Lainnya">Lainnya</option>
                    </select>
                </div>

                <!-- Deskripsi / Keterangan -->
                <div>
                    <label class="block text-[10px] font-bold uppercase tracking-wider text-slate-400 mb-1">Deskripsi / Item</label>
                    <input 
                        type="text" 
                        id="input-deskripsi"
                        required
                        placeholder="Contoh: Bayar Kosan, Beli Makan"
                        class="w-full px-3 py-2.5 bg-white border border-slate-200 rounded-xl text-xs font-medium text-slate-800 placeholder-slate-300 focus:outline-none focus:ring-2 focus:ring-rose-500/20 focus:border-rose-500"
                    />
                </div>

                <!-- Tanggal Transaksi -->
                <div>
                    <label class="block text-[10px] font-bold uppercase tracking-wider text-slate-400 mb-1">Tanggal</label>
                    <input 
                        type="date" 
                        id="input-tanggal"
                        required
                        class="w-full px-3 py-2.5 bg-white border border-slate-200 rounded-xl text-xs font-medium text-slate-700 focus:outline-none focus:ring-2 focus:ring-rose-500/20 focus:border-rose-500"
                    />
                </div>
            </form>
        </main>

        <!-- FLOATING ACTION BUTTON (Presisi & Sejajar seperti tombol index.astro) -->
        <div class="absolute bottom-4 left-0 right-0 px-6 flex justify-center items-center space-x-3 pointer-events-none z-20">
            <a href="/" class="pointer-events-auto bg-slate-200 hover:bg-slate-300 text-slate-700 font-medium px-4 py-2.5 rounded-xl shadow-md flex items-center justify-center space-x-1.5 transition transform active:scale-95 no-underline">
                <span class="text-xs font-semibold">Batal</span>
            </a>
            <button 
                type="submit" 
                form="form-out"
                class="pointer-events-auto flex-1 bg-rose-600 hover:bg-rose-700 text-white font-medium px-5 py-2.5 rounded-xl shadow-md flex items-center justify-center space-x-2 transition transform active:scale-95">
                <span class="text-base font-bold">-</span>
                <span class="text-xs font-semibold">Simpan Pengeluaran</span>
            </button>
        </div>

    </div>

    <!-- SCRIPT SIMPAN KE SUPABASE -->
    <script>
        import { createClient } from '@supabase/supabase-js';

        const supabaseUrl = 'https://qcmfltewnmtvpswthbcj.supabase.co';
        const supabaseKey = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InFjbWZsdGV3bm10dnBzd3RoYmNqIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODY5MzEyMjEsImV4cCI6MjEwMjUwNzIyMX0.gj5rUMELfGeyIOtmWepN-rekU1-lubX1ll-zyGHzVCU';
        const supabase = createClient(supabaseUrl, supabaseKey);

        // Auto fill tanggal hari ini
        const inputTanggal = document.getElementById('input-tanggal') as HTMLInputElement;
        if (inputTanggal) {
            inputTanggal.valueToDate = new Date();
            inputTanggal.value = new Date().toISOString().split('T')[0];
        }

        const formOut = document.getElementById('form-out');
        formOut?.addEventListener('submit', async (e) => {
            e.preventDefault();

            const jumlah = (document.getElementById('input-jumlah') as HTMLInputElement).value;
            const kategori = (document.getElementById('input-kategori') as HTMLSelectElement).value;
            const deskripsi = (document.getElementById('input-deskripsi') as HTMLInputElement).value;
            const tanggal = (document.getElementById('input-tanggal') as HTMLInputElement).value;

            const { data, error } = await supabase
                .from('transactions') // sesuaikan nama tabel kamu
                .insert([
                    { 
                        type: 'out',
                        amount: Number(jumlah), 
                        category: kategori, 
                        description: deskripsi, 
                        date: tanggal 
                    }
                ]);

            if (error) {
                alert('Gagal menyimpan transaksi: ' + error.message);
            } else {
                window.location.href = '/';
            }
        });
    </script>
</body>
</html>